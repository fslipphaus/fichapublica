{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Posição pública ou ato parlamentar",
  "type": "object",
  "required": ["id", "pessoaId", "temaId", "tipo", "posicao", "data", "fonteStatus"],
  "properties": {
    "id": {"type": "string"},
    "pessoaId": {"type": ["integer", "null"]},
    "temaId": {"type": "string"},
    "tipo": {"enum": ["declaracao", "voto", "proposicao", "ato"]},
    "posicao": {"enum": ["favoravel", "contra", "neutra", "incerta"]},
    "texto": {"type": "string"},
    "data": {"type": "string", "format": "date"},
    "fonteUrl": {"type": ["string", "null"]},
    "fonteStatus": {"enum": ["oficial", "secundaria", "placeholder_sem_fonte"]},
    "trechoFonte": {"type": ["string", "null"]},
    "revisadoPorHumano": {"type": "boolean", "default": false}
  }
}

